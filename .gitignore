# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/

# Virtual envs
.venv/
venv/
env/

# Test / lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Type-check caches
.pyre/
.pytype/

# uv
# (uv.lock IS committed; cache dirs are not)
.uv-cache/

# macOS
.DS_Store
._*
.AppleDouble
.LSOverride

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Env files
.env
.env.local
.env.*.local

# Project: model checkpoints
*.ckpt
*.pt
*.pth
*.safetensors
*.onnx
*.onnx.data
# …except the web-demo model, which ships via Git LFS so static deploys
# (Vercel) have the weights at build time. Tracked in .gitattributes.
!web/public/models/net_final.onnx
!web/public/models/net_final.onnx.data

# Project: training logs / runs
# Run dirs themselves are tracked — small files (metrics.jsonl, stdout.log,
# config.yaml, watcher.log, macmon/*.ndjson) are long-term-interesting and
# committed. Large model checkpoints are excluded by `*.pt` above.
wandb/
lightning_logs/
tb_logs/

# Project: experiment outputs (scripts kept, outputs ignored)
# `results/` is the writeup + visual-artifact dir per the experiments/<name>/
# convention — committed on purpose. `cache/` is for transient computation.
experiments/*/cache/

# Project: cached ground-truth artifacts (V* table, etc.)
data/
# M11 Block B parity corpus: small, deterministic reference for the Node
# parity gate. Lives under tests/data/ so it ships with the repo.
!tests/data/

# Jupyter
.ipynb_checkpoints/

# Local Claude Code harness state
.claude/

# M9 web demo
web/node_modules
web/dist
web/playwright-report
web/test-results

# M11 Block B: parity-report.json is regenerable from the corpus + ONNX,
# the corpus itself (tests/data/m11_parity_corpus_3x3.json) is checked in.
web/scripts/parity-report.json

# Local dev runtime (bin/site)
.dev/
